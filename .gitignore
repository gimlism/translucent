# ── Agent scratch (Superpowers ledgers, task briefs/reports, brainstorm mockups) ──
.superpowers/

# ── Build output ─────────────────────────────────────────
# Maven
target/
# Compiled class files
*.class
# IntelliJ compiler output
out/

# ── Packages ─────────────────────────────────────────────
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ── Logs & crash dumps ───────────────────────────────────
*.log
# JVM crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ── IntelliJ IDEA ────────────────────────────────────────
# Ignoring the whole .idea/ dir and module files — each machine
# regenerates its own; nothing IDE-specific is shared via git.
.idea/
*.iml
*.iws
*.ipr

# ── Eclipse / Java language server (e.g. VS Code redhat.java) ─
.classpath
.project
.settings/
.apt_generated/
.factorypath
bin/

# ── VS Code ──────────────────────────────────────────────
.vscode/

# ── NetBeans ─────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/

# ── BlueJ ────────────────────────────────────────────────
*.ctxt

# ── Mobile Tools for Java (J2ME) ─────────────────────────
.mtj.tmp/

# ── OS cruft ─────────────────────────────────────────────
.DS_Store
Thumbs.db
